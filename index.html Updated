<script>
  // Ticker: static text set in HTML

  // Vote widget
  let votes = [42, 35, 23];
  let userVoted = false;
  function castVote(index) {
    if (userVoted) return;
    userVoted = true;
    votes[index] += 5;
    const total = votes.reduce((a, b) => a + b, 0);
    votes = votes.map(v => Math.round(v / total * 100));
    const diff = 100 - votes.reduce((a, b) => a + b, 0);
    votes[0] += diff;
    for (let i = 0; i < 3; i++) {
      document.getElementById('bar-' + i).style.width = votes[i] + '%';
      document.getElementById('pct-' + i).textContent = votes[i] + '%';
    }
    const note = document.querySelector('.vote-note');
    note.textContent = 'Vote recorded in demo. Join to cast a real vote.';
    note.style.color = '#0D7377';
  }

  // Join form
  function handleJoinSubmit(e) {
    e.preventDefault();
    const name = document.getElementById('join-name').value.trim();
    const email = document.getElementById('join-email').value.trim();
    if (!name || !email) return;
    const btn = document.getElementById('join-btn');
    btn.textContent = 'Joining...';
    btn.disabled = true;
    const callbackName = 'ml_callback_' + Date.now();
    window[callbackName] = function(response) {
      btn.textContent = "You're on the list";
      btn.style.background = '#0a5a5d';
      document.getElementById('get-involved').style.display = 'block';
      document.getElementById('get-involved').scrollIntoView({ behavior: 'smooth', block: 'start' });
      delete window[callbackName];
      document.getElementById('ml-jsonp-script')?.remove();
    };
    const params = new URLSearchParams({
      'fields[name]': name, 'fields[email]': email,
      'ml-submit': '1', 'anticsrf': 'true', 'callback': callbackName
    });
    const script = document.createElement('script');
    script.id = 'ml-jsonp-script';
    script.src = 'https://assets.mailerlite.com/jsonp/2222999/forms/182979314445190291/subscribe?' + params.toString();
    script.onerror = function() {
      btn.textContent = "You're on the list";
      btn.style.background = '#0a5a5d';
    };
    document.body.appendChild(script);
  }

  function handleInvolve() {
    const btn = document.querySelector('#get-involved button');
    btn.textContent = 'Thanks, we will be in touch.';
    btn.disabled = true;
  }

  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.stat-card, .pillar-card, .milestone-card, .capability-card, .hiw-step, .wyg-col').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    observer.observe(el);
  });
</script>
<script src="https://groot.mailerlite.com/js/w/webforms.min.js?v95037e5bac78f29ed026832ca21a7c7b" type="text/javascript"></script>
