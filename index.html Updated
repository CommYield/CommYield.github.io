<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CommYield | Fund what matters. Together.</title>
<style>
  :root {
    --teal: #0D7377;
    --teal-light: #14a7ad;
    --teal-dark: #0a5a5d;
    --gold: #D4A017;
    --gold-light: #e8b82a;
    --dark: #111111;
    --dark-2: #1a1a1a;
    --dark-3: #222222;
    --light: #F9F9F9;
    --light-2: #ffffff;
    --text-dark: #1a1a1a;
    --text-muted: #666666;
    --text-light: rgba(255,255,255,0.7);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    background: var(--dark);
    color: var(--light);
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 1.2rem 2.5rem;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(17,17,17,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .nav-logo {
    font-family: 'Georgia', serif;
    font-size: 1.3rem; font-weight: 700;
    letter-spacing: 0.08em; color: var(--light); text-decoration: none;
  }
  .nav-logo span { color: var(--gold); }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    color: var(--text-light); text-decoration: none;
    font-family: 'Georgia', serif; font-size: 0.82rem;
    letter-spacing: 0.1em; text-transform: uppercase; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--gold); }
  .nav-cta {
    background: var(--teal); color: white !important;
    padding: 0.5rem 1.2rem; border-radius: 2px;
    font-size: 0.78rem !important; letter-spacing: 0.12em !important;
    transition: background 0.2s !important;
  }
  .nav-cta:hover { background: var(--teal-light) !important; color: white !important; }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    background: var(--dark);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 8rem 2rem 4rem;
    position: relative; overflow: hidden;
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(13,115,119,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13,115,119,0.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none;
  }
  .hero-glow {
    position: absolute;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(13,115,119,0.12) 0%, transparent 70%);
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .hero-eyebrow {
    font-family: 'Georgia', serif; font-size: 0.72rem;
    letter-spacing: 0.3em; text-transform: uppercase; color: var(--teal-light);
    margin-bottom: 1.8rem; opacity: 0; animation: fadeUp 0.8s 0.2s forwards;
  }
  .hero-headline {
    font-family: 'Georgia', serif;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    font-weight: 400; line-height: 1.1;
    letter-spacing: -0.02em; color: var(--light);
    max-width: 860px; margin-bottom: 1.4rem;
    opacity: 0; animation: fadeUp 0.8s 0.4s forwards;
  }
  .hero-headline em { font-style: italic; color: var(--gold); }
  .hero-sub {
    font-size: clamp(0.95rem, 2vw, 1.1rem); color: var(--text-light);
    max-width: 580px; line-height: 1.75; margin-bottom: 1.8rem;
    font-family: 'Georgia', serif;
    opacity: 0; animation: fadeUp 0.8s 0.55s forwards;
  }

  /* Value bullets */
  .hero-bullets {
    display: flex; flex-direction: column; gap: 0.5rem;
    margin-bottom: 2.5rem; text-align: left;
    opacity: 0; animation: fadeUp 0.8s 0.65s forwards;
  }
  .hero-bullet {
    display: flex; align-items: flex-start; gap: 0.7rem;
    font-family: 'Georgia', serif; font-size: 0.92rem; color: var(--text-light);
  }
  .hero-bullet-check {
    color: var(--teal-light); font-size: 0.9rem; margin-top: 0.1rem; flex-shrink: 0;
  }

  .hero-ctas {
    display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;
    margin-bottom: 1.5rem;
    opacity: 0; animation: fadeUp 0.8s 0.75s forwards;
  }
  .hero-price-note {
    font-family: 'Georgia', serif; font-size: 0.78rem;
    color: rgba(255,255,255,0.3); font-style: italic;
    opacity: 0; animation: fadeUp 0.8s 0.85s forwards;
    margin-bottom: 3rem;
  }
  .btn-primary {
    background: var(--teal); color: white;
    padding: 0.9rem 2.2rem; border: none; border-radius: 2px;
    font-family: 'Georgia', serif; font-size: 0.85rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer; text-decoration: none;
    transition: background 0.2s, transform 0.2s; display: inline-block;
  }
  .btn-primary:hover { background: var(--teal-light); transform: translateY(-1px); }
  .btn-secondary {
    background: transparent; color: var(--light);
    padding: 0.9rem 2.2rem;
    border: 1px solid rgba(255,255,255,0.2); border-radius: 2px;
    font-family: 'Georgia', serif; font-size: 0.85rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer; text-decoration: none;
    transition: border-color 0.2s, transform 0.2s; display: inline-block;
  }
  .btn-secondary:hover { border-color: var(--teal-light); transform: translateY(-1px); }

  /* Ticker */
  .ticker-box {
    display: inline-flex; align-items: center; gap: 1rem;
    border: 1px solid rgba(212,160,23,0.3);
    background: rgba(212,160,23,0.06);
    padding: 0.9rem 2rem; border-radius: 2px;
    opacity: 0; animation: fadeUp 0.8s 1s forwards;
  }
  .ticker-dot { width: 8px; height: 8px; background: var(--gold); border-radius: 50%; animation: pulse 2s infinite; }
  .ticker-label { font-family: 'Georgia', serif; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .ticker-amount { font-family: 'Georgia', serif; font-size: 1.5rem; font-weight: 700; color: var(--gold); letter-spacing: 0.05em; }

  /* ── SECTION SHARED ── */
  section { padding: 6rem 2rem; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .section-eyebrow { font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--teal-light); margin-bottom: 1rem; font-family: 'Georgia', serif; }
  .section-headline { font-family: 'Georgia', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; line-height: 1.2; margin-bottom: 3rem; }
  .dark-section { background: var(--dark); color: var(--light); }
  .light-section { background: var(--light); color: var(--text-dark); }
  .light-section .section-eyebrow { color: var(--teal); }
  .light-section .section-headline { color: var(--text-dark); }

  /* ── WHAT YOU GET (new section) ── */
  #what-you-get {
    background: var(--dark-2);
    padding: 5rem 2rem;
  }
  .wyg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .wyg-col {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 2rem;
    border-radius: 2px;
  }
  .wyg-col-label {
    font-family: 'Georgia', serif; font-size: 0.7rem;
    letter-spacing: 0.25em; text-transform: uppercase;
    margin-bottom: 1.2rem; font-weight: 700;
  }
  .wyg-col-label.before { color: rgba(255,255,255,0.35); }
  .wyg-col-label.after { color: var(--teal-light); }
  .wyg-item {
    font-family: 'Georgia', serif; font-size: 0.92rem;
    color: var(--text-light); line-height: 1.6;
    margin-bottom: 0.8rem; padding-left: 1rem;
    border-left: 2px solid rgba(255,255,255,0.08);
  }
  .wyg-item.after-item {
    border-left-color: var(--teal);
    color: rgba(255,255,255,0.85);
  }
  .ebook-cta-strip {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1.5rem;
    background: rgba(13,115,119,0.12);
    border: 1px solid rgba(13,115,119,0.3);
    padding: 1.8rem 2rem; border-radius: 2px;
  }
  .ebook-cta-strip-left {}
  .ebook-cta-strip-title {
    font-family: 'Georgia', serif; font-size: 1.1rem;
    font-weight: 700; color: var(--light); margin-bottom: 0.3rem;
  }
  .ebook-cta-strip-sub {
    font-family: 'Georgia', serif; font-size: 0.85rem;
    color: var(--text-light);
  }
  .ebook-cta-strip-sub span { color: var(--gold); font-weight: 700; }

  /* ── AI INFRASTRUCTURE ── */
  .ai-headline-sub {
    font-family: 'Georgia', serif; font-size: 1rem;
    color: var(--text-light); max-width: 600px; line-height: 1.7; margin-bottom: 3rem;
  }
  .capability-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem; margin-bottom: 3rem;
  }
  .capability-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-top: 2px solid var(--teal);
    padding: 2rem; border-radius: 2px;
    transition: background 0.2s, border-color 0.2s;
  }
  .capability-card:hover { background: rgba(13,115,119,0.08); border-color: var(--teal-light); }
  .cap-icon { font-size: 1.8rem; margin-bottom: 1rem; }
  .cap-title { font-family: 'Georgia', serif; font-size: 1rem; font-weight: 700; color: var(--light); margin-bottom: 0.5rem; }
  .cap-desc { font-size: 0.85rem; color: var(--text-light); line-height: 1.6; font-family: 'Georgia', serif; }
  .vc-signal {
    background: rgba(212,160,23,0.08); border: 1px solid rgba(212,160,23,0.2);
    padding: 1.5rem 2rem; border-radius: 2px; margin-bottom: 1.5rem;
    font-family: 'Georgia', serif; font-size: 0.95rem; color: var(--gold); font-style: italic;
  }
  .sovereignty { font-family: 'Georgia', serif; font-size: 0.88rem; color: var(--text-light); line-height: 1.7; margin-bottom: 1rem; }

  /* ── ABOUT ── */
  .manifesto {
    font-family: 'Georgia', serif; font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    line-height: 1.8; color: var(--text-muted); max-width: 780px;
    margin-bottom: 3.5rem; font-style: italic;
  }
  .manifesto strong { color: var(--text-dark); font-style: normal; }
  .pillar-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  .pillar-card {
    background: white; border: 1px solid #e8e8e8;
    padding: 2rem; border-radius: 2px; position: relative; overflow: hidden;
  }
  .pillar-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--gold); }
  .pillar-icon { font-size: 1.5rem; margin-bottom: 1rem; }
  .pillar-title { font-family: 'Georgia', serif; font-size: 1.1rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.5rem; }
  .pillar-desc { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; font-family: 'Georgia', serif; }
  .philosophy { background: var(--light); border: 1px solid #e8e8e8; padding: 2.5rem; border-radius: 2px; margin-bottom: 1.5rem; }
  .philosophy p { font-family: 'Georgia', serif; font-size: 1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 0.8rem; }
  .philosophy p:last-child { margin-bottom: 0; }
  .closing-line { font-family: 'Georgia', serif; font-size: 1rem; color: var(--teal); font-style: italic; }

  /* ── TRANSPARENCY ── */
  .stat-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  .stat-card { background: white; border: 1px solid #e8e8e8; border-top: 3px solid var(--teal); padding: 2rem; border-radius: 2px; }
  .stat-card .stat-number { font-family: 'Georgia', serif; font-size: 2.8rem; font-weight: 700; color: var(--teal); line-height: 1; margin-bottom: 0.5rem; }
  .stat-card .stat-label { font-size: 0.85rem; color: var(--text-muted); letter-spacing: 0.05em; font-family: 'Georgia', serif; }
  .split-bar { display: flex; height: 60px; border-radius: 2px; overflow: hidden; margin-bottom: 1rem; }
  .split-bar-left { flex: 1; background: var(--teal); display: flex; align-items: center; justify-content: center; font-family: 'Georgia', serif; font-size: 0.78rem; letter-spacing: 0.08em; color: white; text-align: center; padding: 0 1rem; }
  .split-bar-right { flex: 1; background: var(--gold); display: flex; align-items: center; justify-content: center; font-family: 'Georgia', serif; font-size: 0.78rem; letter-spacing: 0.08em; color: var(--dark); text-align: center; padding: 0 1rem; }
  .split-label { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 3rem; font-family: 'Georgia', serif; }
  .iron-rule { background: var(--light); border-left: 4px solid var(--teal); padding: 1.8rem 2rem; border-radius: 0 2px 2px 0; margin-bottom: 2rem; box-shadow: 0 2px 20px rgba(0,0,0,0.06); }
  .iron-rule p { font-family: 'Georgia', serif; font-size: 1.05rem; line-height: 1.7; color: var(--text-dark); font-style: italic; }
  .monthly-commit { font-family: 'Georgia', serif; font-size: 0.85rem; color: var(--teal); letter-spacing: 0.1em; text-transform: uppercase; display: flex; align-items: center; gap: 0.5rem; }
  .monthly-commit::before { content: ''; display: inline-block; width: 20px; height: 2px; background: var(--teal); }

  /* ── SUPPORT US / STORE ── */
  #links { background: var(--dark-2); padding: 5rem 2rem; }
  .store-featured {
    background: rgba(13,115,119,0.1);
    border: 1px solid rgba(13,115,119,0.4);
    border-radius: 4px; padding: 2rem 2.5rem;
    margin-bottom: 1.2rem;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1.5rem;
  }
  .store-featured-left { display: flex; align-items: center; gap: 1.2rem; }
  .store-featured-icon { font-size: 2rem; }
  .store-featured-title { font-family: 'Georgia', serif; font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.2rem; }
  .store-featured-sub { font-family: 'Georgia', serif; font-size: 0.82rem; color: rgba(255,255,255,0.5); }
  .store-featured-price {
    font-family: 'Georgia', serif; font-size: 1.8rem; font-weight: 700;
    color: var(--gold); letter-spacing: 0.02em;
  }
  .store-featured-price small { font-size: 0.9rem; font-weight: 400; color: rgba(255,255,255,0.4); }
  .store-featured-btn {
    background: var(--teal); color: white;
    padding: 0.75rem 1.8rem; border-radius: 2px;
    font-family: 'Georgia', serif; font-size: 0.82rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none; transition: background 0.2s; display: inline-block;
    white-space: nowrap;
  }
  .store-featured-btn:hover { background: var(--teal-light); }

  .store-bundle {
    background: rgba(212,160,23,0.07);
    border: 1px solid rgba(212,160,23,0.25);
    border-radius: 4px; padding: 2rem 2.5rem;
    margin-bottom: 2rem;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1.5rem;
  }
  .store-bundle-badge {
    background: var(--gold); color: var(--dark);
    font-family: 'Georgia', serif; font-size: 0.65rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.2rem 0.6rem; border-radius: 2px;
    font-weight: 700; margin-left: 0.6rem;
    vertical-align: middle;
  }

  .store-secondary-row {
    display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;
  }
  .store-secondary-item {
    flex: 1; min-width: 200px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px; padding: 1rem 1.4rem;
    text-decoration: none; transition: background 0.2s;
  }
  .store-secondary-item:hover { background: rgba(255,255,255,0.07); }
  .store-secondary-label { font-family: 'Georgia', serif; font-size: 0.88rem; font-weight: 700; color: #fff; margin-bottom: 0.1rem; }
  .store-secondary-sub { font-family: 'Georgia', serif; font-size: 0.75rem; color: rgba(255,255,255,0.4); }
  .store-arrow { color: rgba(255,255,255,0.3); font-size: 1rem; }

  /* Socials */
  .store-socials-label { font-family: 'Georgia', serif; font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 1.2rem; }
  .social-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .social-btn { font-family: 'Georgia', serif; font-size: 0.82rem; color: rgba(255,255,255,0.5); text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.5rem 1rem; border: 1px solid rgba(255,255,255,0.1); border-radius: 2px; transition: color 0.2s, border-color 0.2s; }
  .social-btn:hover { color: var(--gold); border-color: var(--gold); }

  /* ── CAPITAL STRUCTURE ── */
  .capital-flow { display: flex; align-items: stretch; gap: 0; margin-bottom: 3rem; border: 1px solid rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; }
  .capital-flow-center { background: rgba(255,255,255,0.04); padding: 2.5rem 2rem; text-align: center; min-width: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-left: 1px solid rgba(255,255,255,0.08); border-right: 1px solid rgba(255,255,255,0.08); }
  .capital-flow-side { flex: 1; padding: 2.5rem 2rem; display: flex; flex-direction: column; justify-content: center; }
  .capital-flow-side.teal { background: rgba(13,115,119,0.15); }
  .capital-flow-side.gold { background: rgba(212,160,23,0.1); }
  .flow-label { font-family: 'Georgia', serif; font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; margin-bottom: 0.8rem; }
  .flow-label.teal { color: var(--teal-light); }
  .flow-label.gold { color: var(--gold); }
  .flow-title { font-family: 'Georgia', serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .flow-desc { font-size: 0.85rem; color: var(--text-light); line-height: 1.6; font-family: 'Georgia', serif; }
  .flow-arrow { font-size: 1.5rem; color: rgba(255,255,255,0.3); margin-bottom: 0.5rem; }
  .flow-center-label { font-family: 'Georgia', serif; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 0.5rem; }
  .flow-center-title { font-family: 'Georgia', serif; font-size: 1rem; font-weight: 700; color: var(--light); }
  .split-note { font-family: 'Georgia', serif; font-size: 0.88rem; color: var(--text-light); line-height: 1.7; border-left: 2px solid var(--teal); padding-left: 1.2rem; margin-bottom: 3rem; }
  .milestone-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  .milestone-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); padding: 2rem; border-radius: 2px; position: relative; }
  .milestone-num { font-family: 'Georgia', serif; font-size: 2.5rem; font-weight: 700; color: rgba(255,255,255,0.08); line-height: 1; margin-bottom: 0.8rem; }
  .milestone-title { font-family: 'Georgia', serif; font-size: 1rem; font-weight: 700; color: var(--gold); margin-bottom: 0.4rem; }
  .milestone-desc { font-size: 0.85rem; color: var(--text-light); line-height: 1.6; font-family: 'Georgia', serif; }
  .coming-soon-box { border: 1px solid var(--teal); padding: 2rem; border-radius: 2px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .coming-soon-box p { font-family: 'Georgia', serif; font-size: 1rem; color: var(--text-light); font-style: italic; }
  .badge { background: var(--teal); color: white; font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.3rem 0.8rem; border-radius: 2px; font-family: 'Georgia', serif; }

  /* ── VOTE ── */
  .vote-sub { font-family: 'Georgia', serif; font-size: 1rem; color: var(--text-muted); margin-bottom: 3rem; max-width: 560px; line-height: 1.7; }
  .vote-widget { background: white; border: 1px solid #e8e8e8; border-radius: 2px; padding: 2.5rem; margin-bottom: 3rem; box-shadow: 0 4px 30px rgba(0,0,0,0.06); }
  .vote-widget-title { font-family: 'Georgia', serif; font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--teal); margin-bottom: 1.8rem; }
  .vote-cause { margin-bottom: 1.5rem; cursor: pointer; }
  .vote-cause:last-child { margin-bottom: 0; }
  .vote-cause-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
  .vote-cause-name { font-family: 'Georgia', serif; font-size: 0.95rem; color: var(--text-dark); font-weight: 600; }
  .vote-cause-pct { font-family: 'Georgia', serif; font-size: 0.88rem; color: var(--teal); font-weight: 700; }
